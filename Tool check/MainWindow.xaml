<Window x:Class="Tool_check.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tool_check"
        mc:Ignorable="d"
        Title="Hệ Thống Hậu Kiểm Bốc Thăm Độc Lập - NOXH" Height="700" Width="1200"
        Background="#0f172a" Foreground="#f8fafc" FontSize="13" WindowStartupLocation="CenterScreen"
        WindowState="Maximized" Icon="D:\NOXH\Tool check\icon.png">
    
    <Window.Resources>
        <!-- Modern Flat TabItem Template with bottom underline accent -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" BorderThickness="0,0,0,3" BorderBrush="Transparent" Padding="20,12" Margin="0,0,8,0" Background="Transparent" Cursor="Hand">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#3b82f6"/>
                                <Setter Property="Foreground" Value="#3b82f6"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#94a3b8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header Row -->
            <RowDefinition Height="Auto"/>
            <!-- Content Row (Tabbed) -->
            <RowDefinition Height="*"/>
            <!-- Footer Row -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Hệ Thống Hậu Kiểm Bốc Thăm Độc Lập" FontSize="22" FontWeight="Bold" Foreground="#3b82f6"/>
                    <TextBlock Text="Đối chiếu, xác minh mật mã và kiểm tra tính toàn vẹn của kết quả bốc thăm NOXH" FontSize="12" Foreground="#94a3b8" Margin="0,4,0,0"/>
                </StackPanel>
                <Border x:Name="OverallStatusBorder" Grid.Column="1" Background="#2694A3B8" BorderBrush="#4D94A3B8" BorderThickness="1" CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock x:Name="OverallStatusText" Text="CHƯA ĐỐI CHIẾU" FontSize="11" FontWeight="Bold" Foreground="#94a3b8" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Column 1: Control Panel (Fixed on Left) -->
                <ColumnDefinition Width="340"/>
                <!-- Column 2: Dynamic Tabbed Display (Stretches on Right) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 1 Content: Control Panel -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Connection config -->
                <Border Grid.Row="0" Background="#731E293B" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="CẤU HÌNH KẾT NỐI" FontSize="11" FontWeight="Bold" Foreground="#94a3b8" Margin="0,0,0,12"/>
                        
                        <TextBlock Text="Server API URL" FontSize="11" Foreground="#94a3b8" Margin="0,0,0,4"/>
                        <TextBox x:Name="ApiUrlInput" Text="https://demo-boctham.vubao.dev/api" Background="#090d16" BorderBrush="#14FFFFFF" Foreground="#f8fafc" Padding="8,6" Margin="0,0,0,12" SelectionBrush="#3b82f6"/>

                        <TextBlock Text="Project ID (UUID)" FontSize="11" Foreground="#94a3b8" Margin="0,0,0,4"/>
                        <TextBox x:Name="ProjectIdInput" Text="" Background="#090d16" BorderBrush="#14FFFFFF" Foreground="#f8fafc" Padding="8,6" Margin="0,0,0,16"/>

                        <Button x:Name="VerifyBtn" Content="Bắt Đầu Đối Chiếu" Background="#3b82f6" Foreground="White" BorderThickness="0" Padding="0,10" FontWeight="Bold" Cursor="Hand" Click="VerifyBtn_Click"/>
                        <Button x:Name="SelectFileBtn" Content="Chọn File JSON (Offline)..." Background="Transparent" Foreground="#f8fafc" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="0,8" Margin="0,8,0,0" Cursor="Hand" Click="SelectFileBtn_Click"/>
                    </StackPanel>
                </Border>

                <!-- Project Metadata -->
                <Border Grid.Row="1" Background="#731E293B" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="THÔNG TIN DỰ ÁN" FontSize="11" FontWeight="Bold" Foreground="#94a3b8" Margin="0,0,0,12"/>

                        <Grid Margin="0,4">
                            <TextBlock Text="Tên dự án" Foreground="#94a3b8" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="MetaProjectName" Text="-" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="200" HorizontalAlignment="Right" TextAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Hoàn tất" Foreground="#94a3b8" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="MetaCompletedAt" Text="-" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Số chồng phiếu" Foreground="#94a3b8" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="MetaDecksCount" Text="-" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Lượt bốc" Foreground="#94a3b8" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="MetaStepsCount" Text="-" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Column 2 Content: TabControl -->
            <TabControl Grid.Column="1" Background="Transparent" BorderThickness="0">
                
                <!-- Tab 1: Verifications Checklist & HUGE Detailed Log -->
                <TabItem Header="THẨM ĐỊNH &amp; NHẬT KÝ CHI TIẾT">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <!-- Checklist -->
                            <ColumnDefinition Width="340"/>
                            <!-- Huge Log Terminal -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Checklist card -->
                        <Border Grid.Column="0" Background="#731E293B" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="HẠNG MỤC THẨM ĐỊNH" FontSize="11" FontWeight="Bold" Foreground="#94a3b8" Margin="0,0,0,12"/>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- Check 1: R_server commit -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="StatusBadgeCommit" Background="#1e293b" Width="24" Height="24" CornerRadius="12" VerticalAlignment="Top" Margin="0,2,8,0">
                                                <TextBlock x:Name="StatusTextCommit" Text="○" FontSize="11" FontWeight="Bold" Foreground="#94a3b8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="R_server Commit" FontWeight="SemiBold"/>
                                                <TextBlock Text="Xác minh mã cam kết máy chủ trước khi bốc thăm" FontSize="11" Foreground="#94a3b8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Check 2: MASTER_SEED -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="StatusBadgeSeed" Background="#1e293b" Width="24" Height="24" CornerRadius="12" VerticalAlignment="Top" Margin="0,2,8,0">
                                                <TextBlock x:Name="StatusTextSeed" Text="○" FontSize="11" FontWeight="Bold" Foreground="#94a3b8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Hạt Giống Master Seed" FontWeight="SemiBold"/>
                                                <TextBlock Text="Xác thực nguồn ngẫu nhiên phối hợp 3 thành phần" FontSize="11" Foreground="#94a3b8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Check 2b: Blockchain Anchor (ETH/BTC) -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="StatusBadgeBitcoin" Background="#1e293b" Width="24" Height="24" CornerRadius="12" VerticalAlignment="Top" Margin="0,2,8,0">
                                                <TextBlock x:Name="StatusTextBitcoin" Text="○" FontSize="11" FontWeight="Bold" Foreground="#94a3b8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Kiểm tra Blockchain (ETH/BTC)" FontWeight="SemiBold"/>
                                                <TextBlock Text="Xác minh tính chính xác và thời gian đào của block được chọn" FontSize="11" Foreground="#94a3b8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Check 3: DeckHash -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="StatusBadgeDeck" Background="#1e293b" Width="24" Height="24" CornerRadius="12" VerticalAlignment="Top" Margin="0,2,8,0">
                                                <TextBlock x:Name="StatusTextDeck" Text="○" FontSize="11" FontWeight="Bold" Foreground="#94a3b8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Chồng phiếu Niêm Phong (DeckHash)" FontWeight="SemiBold"/>
                                                <TextBlock Text="Serialize canonical và so sánh mã băm xáo chồng phiếu" FontSize="11" Foreground="#94a3b8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Check 4: Hash-Chain -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="StatusBadgeChain" Background="#1e293b" Width="24" Height="24" CornerRadius="12" VerticalAlignment="Top" Margin="0,2,8,0">
                                                <TextBlock x:Name="StatusTextChain" Text="○" FontSize="11" FontWeight="Bold" Foreground="#94a3b8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Nhật Ký Liên Kết (Hash-Chain)" FontWeight="SemiBold"/>
                                                <TextBlock Text="Kiểm tra tính liên tục, không sửa xóa của chuỗi nhật ký" FontSize="11" Foreground="#94a3b8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Check 5: Payload -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="StatusBadgePayload" Background="#1e293b" Width="24" Height="24" CornerRadius="12" VerticalAlignment="Top" Margin="0,2,8,0">
                                                <TextBlock x:Name="StatusTextPayload" Text="○" FontSize="11" FontWeight="Bold" Foreground="#94a3b8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Payload Đối Chiếu" FontWeight="SemiBold"/>
                                                <TextBlock Text="Phiếu rút thực tế khớp với vị trí trong chồng phiếu tương ứng" FontSize="11" Foreground="#94a3b8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Huge Log terminal -->
                        <Border Grid.Column="1" Background="#731E293B" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="CHI TIẾT NHẬT KÝ THẨM ĐỊNH" FontSize="11" FontWeight="Bold" Foreground="#94a3b8" Margin="0,0,0,8"/>
                                <TextBox x:Name="LogOutputTextBox" Grid.Row="1" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Background="#090d16" Foreground="#f8fafc" BorderBrush="#14FFFFFF" Padding="10" FontFamily="Consolas" FontSize="11.5" AcceptsReturn="True"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Tab 2: Full Width Deck Visualizer -->
                <TabItem Header="BẢN MÔ PHỎNG CHỒNG PHIẾU THỰC TẾ">
                    <Border Background="#731E293B" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Selector / Tabs Row -->
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <!-- Visualized tickets grid -->
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="CHỌN CHỒNG PHIẾU ĐỂ XEM CHI TIẾT" FontSize="11" FontWeight="Bold" Foreground="#94a3b8" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DeckStatsText" Text="Chưa nạp chồng phiếu" FontSize="11" FontWeight="Bold" Foreground="#3b82f6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <ComboBox x:Name="DeckSelectorComboBox" Grid.Row="1" Margin="0,0,0,12" Background="#090d16" Foreground="Black" BorderBrush="#14FFFFFF" Padding="8,6" SelectionChanged="DeckSelectorComboBox_SelectionChanged">
                                <ComboBox.Resources>
                                    <!-- Custom styling for ComboBox items to prevent Windows default hover background -->
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="#090d16"/>
                                        <Setter Property="Foreground" Value="#f8fafc"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ComboBoxItem">
                                                    <Border x:Name="BgBorder" Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <!-- Mouse Over Hover styling -->
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="BgBorder" Property="Background" Value="White"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                        </Trigger>
                                                        <!-- Selected state styling -->
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="BgBorder" Property="Background" Value="#3b82f6"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                        <!-- Hovered + Selected styling -->
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsSelected" Value="True"/>
                                                                <Condition Property="IsMouseOver" Value="True"/>
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="BgBorder" Property="Background" Value="White"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ComboBox.Resources>
                            </ComboBox>

                            <!-- Scrollable Tickets Grid wrapper -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="TicketsWrapPanel" Margin="0,0,0,10">
                                    <!-- Cards populated dynamically in code-behind -->
                                </WrapPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </TabItem>
                
                <!-- Tab 3: Raw JSON File View -->
                <TabItem Header="FILE JSON (RAW)">
                    <Border Background="#731E293B" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="NỘI DUNG TỆP JSON MINH BẠCH GỐC (RAW)" FontSize="11" FontWeight="Bold" Foreground="#94a3b8" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <Button x:Name="DownloadJsonBtn" Content="Tải Xuống File JSON" Background="#3b82f6" Foreground="White" BorderThickness="0" Padding="12,4" FontSize="10" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center" Click="DownloadJsonBtn_Click"/>
                            </Grid>
                            <TextBox x:Name="RawJsonTextBox" Grid.Row="1" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Background="#090d16" Foreground="#f8fafc" BorderBrush="#14FFFFFF" Padding="10" FontFamily="Consolas" FontSize="11.5" AcceptsReturn="True"/>
                        </Grid>
                    </Border>
                </TabItem>
                
            </TabControl>
        </Grid>
        
        <!-- Statusbar Footer -->
        <StatusBar Grid.Row="2" Background="Transparent" Foreground="#94a3b8" Margin="0,12,0,0" Padding="0">
            <StatusBarItem Padding="0">
                <TextBlock x:Name="StatusbarText" Text="Sẵn sàng." FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
